{
  "name": "@sparkii/desktop",
  "productName": "Sparkii",
  "version": "0.1.0",
  "private": true,
  "description": "Sparkii Desktop – contract review pilot",
  "author": {
    "name": "深圳宇岳向上科技有限公司"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "test": "vitest run",
    "gen:surfaces": "node scripts/generate-surface-bindings.mjs",
    "prebuild:renderer": "node scripts/generate-surface-bindings.mjs",
    "build:native-sandbox": "node native/windows-sandbox/build.mjs",
    "dev": "vite",
    "predev": "node scripts/generate-surface-bindings.mjs",
    "prestart": "node scripts/ensure-document-parse.mjs",
    "start": "pnpm build:renderer && pnpm build:main && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:main:check": "tsc --noEmit -p tsconfig.electron.json",
    "smoke:pi-runtime": "node scripts/smoke-pi-runtime-bundle.mjs",
    "prebuild:main": "node native/windows-sandbox/build.mjs && node -e \"const fs=require('fs');fs.rmSync('dist-electron',{recursive:true,force:true})\"",
    "build:main": "node scripts/build-main.mjs",
    "build:watchdog": "node scripts/build-watchdog-sea.mjs",
    "ensure:runtime": "node scripts/ensure-runtime.mjs && node scripts/ensure-document-parse.mjs",
    "dist": "pnpm ensure:runtime && pnpm build:renderer && pnpm build:main && pnpm build:watchdog && node scripts/install-native-deps.mjs --rebuild && electron-builder --win nsis --publish never --config electron-builder.config.mjs && node scripts/create-release-manifest.mjs",
    "postinstall": "node scripts/install-native-deps.mjs"
  },
  "dependencies": {
    "@sparkii/agent-host": "workspace:*",
    "@sparkii/approval": "workspace:*",
    "@sparkii/config": "workspace:*",
    "@sparkii/connectors": "workspace:*",
    "@sparkii/identity": "workspace:*",
    "@sparkii/model-router": "workspace:*",
    "@sparkii/theme": "workspace:*",
    "@sparkii/ui": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "docx-preview": "^0.4.0",
    "electron-updater": "6.3.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postject": "1.0.0-alpha.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
