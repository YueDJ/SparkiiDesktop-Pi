+  redactTexts(texts: string[]): void {
+    const values = [...new Set(texts.filter((text) => text.length > 0))].sort((a, b) => b.length - a.length);
+    if (!values.length) return;
+    const rows = this.db.prepare('SELECT id, message FROM error_events').all() as Array<{ id: string; message: string }>;
+    const update = this.db.prepare('UPDATE error_events SET message = ? WHERE id = ?');
+    this.db.transaction(() => {
+      for (const row of rows) {
+        let message = row.message;
+        for (const value of values) {
+          message = message.split(value).join('[已删除]');
+          message = message.split(JSON.stringify(value).slice(1, -1)).join('[已删除]');
+        }
+        if (message !== row.message) update.run(message, row.id);
+      }
+    })();
+  }
+
   close(): void {
     this.db.close();
   }
