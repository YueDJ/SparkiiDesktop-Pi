[{"node":{"id":"b1929b56-577d-5a21-8ae3-0410c925e1d0","type":"document_chunk","content":"一、窑尾温度控制：正常工况下窑尾温度应保持在 1050℃ 至 1150℃ 之间。","properties":{"domain_id":"d264d494-01c7-4bf9-8c03-cd68219716ab","document_id":"071c7edd-f080-4cee-8dd5-14a88c674da1","ordinal":1,"content":"一、窑尾温度控制：正常工况下窑尾温度应保持在 1050℃ 至 1150℃ 之间。"},"valid_from":null,"valid_until":null},"score":78.4},{"node":{"id":"00d1b7bb-44b8-58b2-816b-3acb852fe718","type":"document_chunk","content":"二、异常处置：当窑尾温度连续 30 分钟低于 1000℃ 时，应触发工艺异常告警并通知中控。","properties":{"domain_id":"d264d494-01c7-4bf9-8c03-cd68219716ab","document_id":"071c7edd-f080-4cee-8dd5-14a88c674da1","ordinal":2,"content":"二、异常处置：当窑尾温度连续 30 分钟低于 1000℃ 时，应触发工艺异常告警并通知中控。"},"valid_from":null,"valid_until":null},"score":78.4}]